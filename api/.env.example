# ====================================
# Configuration de l'API - TP07
# ====================================

# JWT - Sécurité
# Clé secrète pour signer les access tokens (durée: 30 minutes)
# Générer une clé forte avec : openssl rand -base64 32
JWT_SECRET=votre_cle_secrete_access_token_changez_moi

# Clé secrète pour signer les refresh tokens (durée: 7 jours)
# Doit être différente de JWT_SECRET pour plus de sécurité
# Générer une clé forte avec : openssl rand -base64 32
REFRESH_TOKEN_SECRET=votre_cle_secrete_refresh_token_changez_moi

# ====================================
# Base de données PostgreSQL
# ====================================

# Hôte de la base de données
# Local: localhost
# Render/Heroku: url fournie par le service
DB_HOST=localhost

# Port de la base de données PostgreSQL
# Par défaut: 5432
DB_PORT=5432

# Nom d'utilisateur de la base de données
DB_USER=votre_user_postgres

# Mot de passe de la base de données
# ⚠️ NE JAMAIS COMMIT CE FICHIER AVEC LE VRAI MOT DE PASSE
DB_PASSWORD=votre_mot_de_passe_postgres

# Nom de la base de données
DB_NAME=nom_de_votre_base

# ====================================
# Notes importantes
# ====================================
# 1. Copier ce fichier vers .env et remplir avec vos vraies valeurs
# 2. Le fichier .env ne doit JAMAIS être commité (vérifier .gitignore)
# 3. Générer des clés fortes pour JWT_SECRET et REFRESH_TOKEN_SECRET
# 4. En production, utiliser des variables d'environnement du service (Render, Heroku, etc.)
